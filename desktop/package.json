{
  "name": "bullpen-command",
  "productName": "Bullpen Command",
  "version": "0.3.0",
  "description": "Measure pitch command from bullpen video and track athletes over time.",
  "author": "thelg4",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/scoring.test.js test/ui-logic.test.js test/menu.test.js test/balltrack.test.js test/glovefind.test.js test/autodetect.test.js test/detector.test.js && ELECTRON_RUN_AS_NODE=1 electron --test test/db.test.js",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64",
    "test:e2e": "node test/e2e/tagging.e2e.mjs",
    "test:packaged": "node test/e2e/packaged.e2e.mjs"
  },
  "build": {
    "appId": "com.thelg4.bullpencommand",
    "productName": "Bullpen Command",
    "files": [
      "main.js",
      "db.js",
      "detector.js",
      "preload.cjs",
      "menu-template.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/*/linux/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "*.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "!node_modules/onnxruntime-node/bin/*/win32/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/*/darwin/**"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "thelg4",
      "repo": "pitch-tracker"
    },
    "artifactName": "Bullpen-Command-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  }
}
